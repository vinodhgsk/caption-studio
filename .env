# Caption Studio Environment Configuration
# Copy this file to .env and configure the variables as needed.

# ── Speech-to-Text (STT) Provider Settings ──────────────────────────────
# Supported values: 'whisper' (local Whisper binary), 'stub' (mock provider), 'cloud' (cloud mock)
CAPTION_STUDIO_STT_PROVIDER=stub

# Path to the local whisper-cli executable (required when CAPTION_STUDIO_STT_PROVIDER=whisper)
# Example: C:\whisper.cpp\build\bin\Release\whisper-cli.exe
CAPTION_STUDIO_WHISPER_BIN=whisper-cli

# Path to the ggml model file (required when CAPTION_STUDIO_STT_PROVIDER=whisper)
# Example: C:\whisper.cpp\models\ggml-base.bin
CAPTION_STUDIO_WHISPER_MODEL=models/ggml-base.bin

# ── Aligner Aligner/Forced Alignment (Lyrics alignment) Settings ──────────────────
# Path to the Python executable used for aligner processing
# Example: C:\Python311\python.exe
CAPTION_STUDIO_ALIGN_PY=python

# Path to the custom python aligner script
CAPTION_STUDIO_ALIGN_SCRIPT=resources/pyalign/forced_align.py

# ── FFmpeg / FFprobe settings ───────────────────────────────────────────
# Custom path to ffprobe if it is not on your system path
CAPTION_STUDIO_FFPROBE=ffprobe

# ── Font Suggestions settings ───────────────────────────────────────────
# Supported values: 'local' (local suggest index), 'cloud' (cloud suggestion stub)
CAPTION_STUDIO_FONT_SUGGEST_PROVIDER=local
